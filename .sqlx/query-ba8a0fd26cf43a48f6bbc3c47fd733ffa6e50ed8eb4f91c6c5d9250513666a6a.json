  "query": "SELECT a.id AS account_id, a.username, u.email, u.created_at\n           FROM users u\n           JOIN accounts a ON a.id = u.account_id\n           WHERE a.domain IS NULL\n             AND u.approved = false\n           ORDER BY u.created_at ASC",
