  "db_name": "PostgreSQL",
  "query": "SELECT s.* FROM statuses s\n               JOIN status_pins sp ON sp.status_id = s.id\n               WHERE sp.account_id = $1 AND s.deleted_at IS NULL\n                 AND (\n                   s.visibility IN (0, 1)\n                   OR ($2::boolean = true)\n                   OR ($3::boolean = true AND s.visibility = 2)\n                 )\n               ORDER BY sp.id DESC",
