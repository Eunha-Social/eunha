  "db_name": "PostgreSQL",
  "query": "SELECT m.* FROM media_attachments m\n           JOIN LATERAL (\n               SELECT COALESCE(array_position(s.ordered_media_attachment_ids, m.id), 2147483647) AS ord\n               FROM statuses s WHERE s.id = $1\n           ) o ON true\n           WHERE m.status_id = $1\n           ORDER BY o.ord, m.id",
