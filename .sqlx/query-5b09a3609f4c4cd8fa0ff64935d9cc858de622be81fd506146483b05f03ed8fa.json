  "query": "SELECT t.id, t.account_id, t.application_id, t.scopes, t.expires_at, t.revoked_at,\n                      u.id as \"user_id?\"\n               FROM oauth_access_tokens t\n               LEFT JOIN users u ON u.account_id = t.account_id\n               WHERE t.token = $1",
