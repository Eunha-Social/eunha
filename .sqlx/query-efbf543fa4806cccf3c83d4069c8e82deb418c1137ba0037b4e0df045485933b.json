{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.encrypted_password, a.id as account_id, a.username\n           FROM users u\n           JOIN accounts a ON a.id = u.account_id\n           WHERE lower(u.email) = lower($1)\n             AND u.confirmed_at IS NOT NULL\n             AND a.domain IS NULL",
