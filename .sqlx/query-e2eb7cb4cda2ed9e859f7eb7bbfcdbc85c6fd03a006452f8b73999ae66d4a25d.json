  "query": "SELECT ft.id, t.name, ft.statuses_count, ft.last_status_at, a.username, a.domain\n           FROM featured_tags ft\n           JOIN tags t ON t.id = ft.tag_id\n           JOIN accounts a ON a.id = ft.account_id\n           WHERE ft.account_id = $1\n           ORDER BY ft.id",
