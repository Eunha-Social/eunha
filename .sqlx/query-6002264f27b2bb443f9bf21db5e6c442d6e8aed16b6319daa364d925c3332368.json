  "query": "SELECT i.id, i.uses, i.max_uses, i.expires_at,\n                  u.confirmed_at, u.approved, u.disabled,\n                  a.suspended_at, a.memorial, a.moved_to_account_id\n           FROM invites i\n           JOIN users u ON u.id = i.user_id\n           JOIN accounts a ON a.id = u.account_id\n           WHERE i.code = $1",
