  "query": "SELECT id, name, trendable, usable, listable, reviewed_at\n           FROM tags\n           WHERE ($2::bigint IS NULL OR id < $2)\n             AND ($3::bigint IS NULL OR id > $3)\n             AND ($4::bigint IS NULL OR id > $4)\n             AND ($5::text IS NULL OR name = $5)\n           ORDER BY id DESC\n           LIMIT $1",
