  "query": "SELECT f.id, a.uri AS account_uri, a.username\n               FROM follows f JOIN accounts a ON a.id = f.target_account_id\n               WHERE f.account_id = $1 AND ($2::bigint IS NULL OR f.id < $2)\n               ORDER BY f.id DESC LIMIT $3",
