{
  "db_name": "PostgreSQL",
  "query": "SELECT nr.id, nr.from_account_id, nr.last_status_id, nr.notifications_count, nr.created_at, nr.updated_at\n           FROM notification_requests nr\n           WHERE nr.account_id = $1 AND NOT nr.dismissed\n             AND ($3::bigint IS NULL OR nr.id < $3)\n             AND ($4::bigint IS NULL OR nr.id > $4)\n             AND ($5::bigint IS NULL OR nr.id > $5)\n           ORDER BY nr.id DESC\n           LIMIT $2",
