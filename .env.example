DATABASE_URL=postgres://eunha:eunha@localhost/eunha
BIND_ADDRESS=0.0.0.0:3000
CONSOLE_DOMAIN=eunha.social

# Build without a live database (uses .sqlx offline cache):
#   SQLX_OFFLINE=true cargo build
# Regenerate the cache after changing queries:
#   DATABASE_URL=... cargo sqlx prepare

# Media storage: local or s3
MEDIA_STORAGE__TYPE=local
MEDIA_STORAGE__BASE_PATH=./media
MEDIA_STORAGE__BASE_URL=https://your-domain.example/media

# S3 example:
# MEDIA_STORAGE__TYPE=s3
# MEDIA_STORAGE__BUCKET=my-bucket
# MEDIA_STORAGE__REGION=us-east-1
# MEDIA_STORAGE__ACCESS_KEY_ID=...
# MEDIA_STORAGE__SECRET_ACCESS_KEY=...
# MEDIA_STORAGE__BASE_URL=https://cdn.example.com

# Optional SMTP
# SMTP__HOST=smtp.example.com
# SMTP__PORT=587
# SMTP__USERNAME=user
# SMTP__PASSWORD=pass
# SMTP__FROM=notifications@example.com

# Mastodon's ActiveRecord encryption secrets. Required only to read or write
# `keypairs.private_key`, where Mastodon 4.7 keeps local accounts' signing keys
# encrypted at rest. Set them to the same values as the Mastodon this database
# came from; without them, signing keys stay in the legacy `accounts` columns.
# ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY=...
# ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT=...
# Mastodon's own single-underscore names are accepted too, so its
# .env.production can be copied across unchanged.

# Where to ask about newer Mastodon releases and the end of support of the one
# eunha implements. Defaults to the server Mastodon itself asks; set it empty
# to make no such request.
# SOFTWARE_UPDATE_URL=https://api.joinmastodon.org/update-check

# Attach FEP-8b32 integrity proofs to outgoing activities, so a relayed or
# forwarded copy stays attributable. Off by default, because Mastodon verifies
# these but does not produce them; turning it on is additive.
# SIGN_INTEGRITY_PROOFS=true
